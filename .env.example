# --- Local open-weight inference (the core of the project) ---
# Leave LLM_BASE_URL empty to auto-detect: LM Studio (localhost:1234/v1) then Ollama (localhost:11434/v1)
LLM_BASE_URL=
# The open-weight model your local server has loaded (e.g. google/gemma-3n-e2b, llama-3.2-3b)
LLM_MODEL=
# --- Remote OpenAI-compatible open-weight endpoint (for hosted deploys) ---
# Render has no GPU, so point the app at a remote Gemma endpoint. Google AI
# Studio (Gemini API) serves Gemma open weights on its free OpenAI-compatible
# endpoint -- no credit card. Paste these into the Render dashboard (set
# LLM_API_KEY there as a secret), or locally in .env:
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=gemma-4-26b-a4b-it
#   LLM_API_KEY=...                # from https://aistudio.google.com/apikey
# Leave LLM_API_KEY blank for local LM Studio / Ollama.
LLM_API_KEY=
# Gemma 4 is a thinking model: it emits a <thought> block before the answer, so
# give it headroom to finish thinking and still produce REPLY/CORRECTIONS/VOCAB.
LLM_MAX_TOKENS=700
# Tip: pin the exact model id to skip auto-detect, e.g. LLM_MODEL=google/gemma-3n-e2b
# Sampling temperature for the tutor
LLM_TEMPERATURE=0.6
# Per-request timeout in seconds
LLM_TIMEOUT=120
# Cap reply length (lower = faster answers on a laptop GPU)
LLM_MAX_TOKENS=180

# --- Storage ---
# Where the offline SQLite database lives. Everything stays on this machine.
DATA_DIR=./data

# Best Use of Sentry Agent Tracing: trace the agent's latency/tokens/cost
SENTRY_DSN=

# --- Server ---
PORT=8000
