# --- Local open-weight inference (the core of the project) ---
# Leave LLM_BASE_URL empty to auto-detect: LM Studio (localhost:1234/v1) then Ollama (localhost:11434/v1)
LLM_BASE_URL=
# The open-weight model your local server has loaded (e.g. google/gemma-3n-e2b, llama-3.2-3b)
LLM_MODEL=
# Optional API key, only for a remote OpenAI-compatible open-weight endpoint
# (e.g. a hosted Gemma). Leave blank for local LM Studio / Ollama.
LLM_API_KEY=
# Tip: pin the exact model id to skip auto-detect, e.g. LLM_MODEL=google/gemma-3n-e2b
# Sampling temperature for the tutor
LLM_TEMPERATURE=0.6
# Per-request timeout in seconds
LLM_TIMEOUT=120
# Cap reply length (lower = faster answers on a laptop GPU)
LLM_MAX_TOKENS=180

# --- Storage ---
# Where the offline SQLite database lives. Everything stays on this machine.
DATA_DIR=./data

# Best Use of Sentry Agent Tracing: trace the agent's latency/tokens/cost
SENTRY_DSN=

# --- Server ---
PORT=8000
